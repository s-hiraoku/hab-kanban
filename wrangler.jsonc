{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hab-kanban",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Served at hab-kanban.hiraoku.dev. hiraoku.dev must be a zone in the same Cloudflare account; the deploy
	// creates the DNS record and certificate. The workers.dev address stays on while agents move to the new URL.
	"routes": [{ "pattern": "hab-kanban.hiraoku.dev", "custom_domain": true }],
	"workers_dev": true,
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hab-kanban",
			// From `wrangler d1 create hab-kanban`. Local dev does not need it.
			"database_id": "b01c427a-20b6-4787-b788-6f8af9c3ebed",
			"migrations_dir": "migrations"
		}
	],
	"observability": { "enabled": true }
}
